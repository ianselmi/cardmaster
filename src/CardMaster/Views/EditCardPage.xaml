<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CardMaster.Views.EditCardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:CardMaster.Views"
    Title="Modifica carta">

    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource PagePadding}" Spacing="{StaticResource SectionSpacing}">

            <VerticalStackLayout Spacing="4">
                <Label Text="Codice a barre" Style="{StaticResource CaptionLabel}" />
                <!-- Valore immutabile: sola lettura -->
                <Entry Text="{Binding BarcodeValue}" IsReadOnly="True" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Label Text="Formato" Style="{StaticResource CaptionLabel}" />
                <Picker
                    ItemsSource="{Binding Formats}"
                    SelectedItem="{Binding SelectedFormat}"
                    Title="Seleziona il formato" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Label Text="Emittente" Style="{StaticResource CaptionLabel}" />
                <Picker
                    ItemsSource="{Binding IssuerOptions}"
                    SelectedItem="{Binding SelectedIssuerOption}" />
                <Entry
                    Text="{Binding CustomIssuerName}"
                    Placeholder="Nome emittente"
                    IsVisible="{Binding IsCustomIssuer}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Label Text="Nome della carta" Style="{StaticResource CaptionLabel}" />
                <Entry Text="{Binding DisplayName}" Placeholder="Come vuoi chiamarla" />
            </VerticalStackLayout>

            <views:CardColorPickerView />

            <views:CardLabelEditorView />

            <Button Text="Salva" Clicked="OnSaveClicked" Margin="0,12,0,0" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
