<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CardMaster.Views.ScanPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:scanner="clr-namespace:BarcodeScanning;assembly=BarcodeScanning.Native.Maui"
    Title="Scansiona una carta">

    <Grid>
        <scanner:CameraView
            x:Name="Camera"
            OnDetectionFinished="OnDetectionFinished" />

        <!-- Messaggio mostrato se il permesso camera è negato -->
        <VerticalStackLayout
            x:Name="PermissionDeniedPanel"
            IsVisible="False"
            Padding="{StaticResource PagePadding}"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            Spacing="{StaticResource ItemSpacing}">
            <Label
                Text="Permesso camera negato"
                FontSize="{StaticResource FontSizeTitle}"
                HorizontalOptions="Center" />
            <Label
                Text="Puoi comunque scegliere un'immagine o inserire il codice a mano."
                Style="{StaticResource CaptionLabel}"
                HorizontalTextAlignment="Center"
                HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- Percorsi alternativi alla scansione live: restano disponibili anche
             senza permesso camera. -->
        <Grid
            ColumnDefinitions="*,*"
            ColumnSpacing="{StaticResource ItemSpacing}"
            Margin="16"
            VerticalOptions="End">
            <Button
                Grid.Column="0"
                Text="Inserisci a mano"
                LineBreakMode="WordWrap"
                Clicked="OnManualEntryClicked" />
            <Button
                Grid.Column="1"
                x:Name="PickImageButton"
                Text="Scegli da un'immagine"
                LineBreakMode="WordWrap"
                Clicked="OnPickImageClicked" />
        </Grid>
    </Grid>

</ContentPage>
