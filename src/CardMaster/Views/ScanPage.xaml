<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CardMaster.Views.ScanPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:scanner="clr-namespace:BarcodeScanning;assembly=BarcodeScanning.Native.Maui"
    Title="Scansiona una carta">

    <Grid>
        <scanner:CameraView
            x:Name="Camera"
            OnDetectionFinished="OnDetectionFinished" />

        <!-- Messaggio mostrato se il permesso camera è negato -->
        <VerticalStackLayout
            x:Name="PermissionDeniedPanel"
            IsVisible="False"
            Padding="{StaticResource PagePadding}"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            Spacing="{StaticResource ItemSpacing}">
            <Label
                Text="Permesso camera negato"
                FontSize="{StaticResource FontSizeTitle}"
                HorizontalOptions="Center" />
            <Label
                Text="Puoi comunque inserire il codice a mano."
                Style="{StaticResource CaptionLabel}"
                HorizontalOptions="Center" />
        </VerticalStackLayout>

        <Button
            Text="Inserisci a mano"
            Clicked="OnManualEntryClicked"
            Margin="24"
            HorizontalOptions="Center"
            VerticalOptions="End" />
    </Grid>

</ContentPage>
