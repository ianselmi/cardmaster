<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CardMaster.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:CardMaster.Views"
    Title="Impostazioni">

    <ContentPage.Resources>
        <views:BackupStatusToColorConverter x:Key="BackupStatusToColor" />
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource PagePadding}" Spacing="{StaticResource SectionSpacing}">

            <VerticalStackLayout Spacing="4">
                <Label Text="Aspetto" Style="{StaticResource CaptionLabel}" />
                <Picker
                    ItemsSource="{Binding ThemeOptions}"
                    SelectedItem="{Binding SelectedTheme}"
                    Title="Tema dell'app" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Label Text="Info app" Style="{StaticResource CaptionLabel}" />
                <Label Text="{Binding AppName}" FontSize="{StaticResource FontSizeBody}" />
                <Label Text="{Binding AppVersion}" Style="{StaticResource CaptionLabel}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Label Text="Dati" Style="{StaticResource CaptionLabel}" />
                <Button
                    Text="Backup su Google Drive"
                    Clicked="OnBackupClicked"
                    BackgroundColor="{Binding BackupState, Converter={StaticResource BackupStatusToColor}}" />
                <Label Text="{Binding BackupStatusText}" Style="{StaticResource CaptionLabel}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Label Text="Scontrini" Style="{StaticResource CaptionLabel}" />
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="Conserva l'immagine degli scontrini" VerticalOptions="Center" />
                    <Switch Grid.Column="1" IsToggled="{Binding KeepReceiptImages}" />
                </Grid>
                <Label Text="{Binding ReceiptImagesSizeText}" Style="{StaticResource CaptionLabel}" />
                <Button
                    Text="Libera spazio"
                    IsVisible="{Binding HasReceiptImages}"
                    Clicked="OnClearReceiptImagesClicked" />
            </VerticalStackLayout>

            <!--
                Lettura assistita: l'unica funzione dell'app che fa uscire un dato dal device.
                Nasce spenta, e ciò che esce è dichiarato qui — prima di accenderla, non dopo.
            -->
            <VerticalStackLayout Spacing="4">
                <Label Text="Lettura assistita degli scontrini" Style="{StaticResource CaptionLabel}" />

                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="Rileggi con l'AI gli scontrini che non tornano" VerticalOptions="Center" />
                    <Switch Grid.Column="1" IsToggled="{Binding AiScanEnabled}" Toggled="OnAiScanToggled" />
                </Grid>

                <Label Text="{Binding AiStatusText}" Style="{StaticResource CaptionLabel}" />
                <Label Text="{Binding AiDisclosureText}" Style="{StaticResource CaptionLabel}" />

                <Picker
                    ItemsSource="{Binding AiModelOptions}"
                    SelectedItem="{Binding SelectedAiModel}"
                    Title="Modello" />

                <Button Text="Inserisci la chiave" Clicked="OnSetAiKeyClicked" />
                <Button Text="Verifica la chiave" IsVisible="{Binding AiKeyConfigured}" Clicked="OnVerifyAiKeyClicked" />
                <Button Text="Rimuovi la chiave" IsVisible="{Binding AiKeyConfigured}" Clicked="OnRemoveAiKeyClicked" />

                <Label Text="{Binding AiLastCostText}" Style="{StaticResource CaptionLabel}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Label Text="Aggiornamenti" Style="{StaticResource CaptionLabel}" />
                <Button Text="Controllo aggiornamenti" Clicked="OnUpdateClicked" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
