<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CardMaster.Views.CardListPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:data="clr-namespace:CardMaster.Data"
    xmlns:views="clr-namespace:CardMaster.Views"
    Title="Le mie carte">

    <ContentPage.Resources>
        <views:NameToTileColorConverter x:Key="NameToTileColor" />
    </ContentPage.Resources>

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Aggiungi" Clicked="OnAddClicked" />
        <ToolbarItem
            Text="Impostazioni"
            IconImageSource="settings.png"
            Clicked="OnSettingsClicked" />
    </ContentPage.ToolbarItems>

    <CollectionView
        ItemsSource="{Binding Cards}"
        SelectionMode="Single"
        SelectionChanged="OnCardSelected">

        <CollectionView.ItemsLayout>
            <GridItemsLayout
                Orientation="Vertical"
                Span="2"
                HorizontalItemSpacing="12"
                VerticalItemSpacing="12" />
        </CollectionView.ItemsLayout>

        <CollectionView.EmptyView>
            <VerticalStackLayout
                Padding="{StaticResource PagePadding}"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Spacing="{StaticResource ItemSpacing}">
                <Label
                    Text="Nessuna carta ancora"
                    FontSize="{StaticResource FontSizeTitle}"
                    HorizontalOptions="Center" />
                <Label
                    Text="Le carte scansionate compariranno qui."
                    Style="{StaticResource CaptionLabel}"
                    HorizontalOptions="Center" />
            </VerticalStackLayout>
        </CollectionView.EmptyView>

        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="data:Card">
                <Border
                    Margin="4"
                    HeightRequest="160"
                    BackgroundColor="{Binding DisplayName, Converter={StaticResource NameToTileColor}}"
                    StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Padding="16" VerticalOptions="End" Spacing="2">
                        <Label
                            Text="{Binding DisplayName}"
                            TextColor="White"
                            FontSize="18"
                            FontAttributes="Bold"
                            LineBreakMode="TailTruncation"
                            MaxLines="2" />
                        <Label
                            Text="{Binding IssuerName}"
                            TextColor="White"
                            Opacity="0.85"
                            FontSize="12"
                            LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>

    </CollectionView>

</ContentPage>
