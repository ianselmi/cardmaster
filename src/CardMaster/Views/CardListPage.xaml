<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CardMaster.Views.CardListPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:data="clr-namespace:CardMaster.Data"
    xmlns:views="clr-namespace:CardMaster.Views"
    xmlns:vm="clr-namespace:CardMaster.ViewModels"
    x:Name="Page"
    Title="Le mie carte">

    <ContentPage.Resources>
        <views:CardToTileColorConverter x:Key="CardToTileColor" />
        <views:UpdateAvailableToIconConverter x:Key="UpdateAvailableToIcon" />
    </ContentPage.Resources>

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Aggiungi" Clicked="OnAddClicked" />
        <ToolbarItem
            Text="Impostazioni"
            IconImageSource="{Binding IsUpdateAvailable, Converter={StaticResource UpdateAvailableToIcon}}"
            Clicked="OnSettingsClicked" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*" RowSpacing="{StaticResource ItemSpacing}">

        <Border
            Grid.Row="0"
            Margin="{StaticResource PagePadding}"
            Padding="12"
            IsVisible="{Binding IsUpdateAvailable}"
            BackgroundColor="{StaticResource Secondary}"
            StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnUpdateBannerTapped" />
            </Border.GestureRecognizers>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Label
                    Grid.Column="0"
                    Text="{Binding UpdateAvailableVersion, StringFormat='È disponibile la versione {0}. Tocca per aggiornare.'}"
                    TextColor="{StaticResource PrimaryDarkText}"
                    FontSize="{StaticResource FontSizeBody}"
                    VerticalOptions="Center" />
                <Label
                    Grid.Column="1"
                    Text="✕"
                    TextColor="{StaticResource PrimaryDarkText}"
                    VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnUpdateBannerDismissTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </Grid>
        </Border>

        <SearchBar
            Grid.Row="1"
            Margin="{StaticResource PagePadding}"
            Placeholder="Cerca per nome o emittente"
            Text="{Binding SearchText}" />

        <Label
            Grid.Row="2"
            Margin="20,-8,20,0"
            Text="{Binding CountText}"
            Style="{StaticResource CaptionLabel}" />

        <!-- Filtro per label: selezione multipla in OR, nascosto finché non esiste nessuna label -->
        <CollectionView
            Grid.Row="3"
            Margin="20,4,20,0"
            HeightRequest="44"
            IsVisible="{Binding HasLabelFilters}"
            ItemsSource="{Binding LabelFilters}"
            SelectionMode="None">

            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:LabelFilterItem">
                    <Border
                        Margin="0,4"
                        Padding="14,6"
                        BackgroundColor="Transparent"
                        Stroke="{StaticResource Gray300}"
                        StrokeThickness="1"
                        VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding BindingContext.ToggleLabelFilterCommand, Source={x:Reference Page}, x:DataType='vm:CardListViewModel'}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                <Setter Property="Stroke" Value="{StaticResource Primary}" />
                            </DataTrigger>
                        </Border.Triggers>

                        <Label
                            Text="{Binding Name}"
                            FontSize="{StaticResource FontSizeBody}"
                            VerticalOptions="Center">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="TextColor" Value="White" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label
            Grid.Row="4"
            Margin="20,4,20,0"
            Text="Usate di recente"
            Style="{StaticResource CaptionLabel}"
            IsVisible="{Binding HasRecentCards}" />

        <CollectionView
            Grid.Row="5"
            Margin="20,4"
            HeightRequest="90"
            IsVisible="{Binding HasRecentCards}"
            ItemsSource="{Binding RecentCards}"
            SelectionMode="Single"
            SelectionChanged="OnCardSelected">

            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="12" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="data:Card">
                    <Border
                        WidthRequest="110"
                        HeightRequest="90"
                        BackgroundColor="{Binding ., Converter={StaticResource CardToTileColor}}"
                        StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Padding="10" VerticalOptions="End" Spacing="1">
                            <Label
                                Text="{Binding DisplayName}"
                                TextColor="White"
                                FontSize="13"
                                FontAttributes="Bold"
                                LineBreakMode="TailTruncation"
                                MaxLines="2" />
                            <Label
                                Text="{Binding IssuerName}"
                                TextColor="White"
                                Opacity="0.85"
                                FontSize="10"
                                LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

        <CollectionView
            Grid.Row="6"
            ItemsSource="{Binding FilteredCards}"
            SelectionMode="Single"
            SelectionChanged="OnCardSelected">

            <CollectionView.ItemsLayout>
                <GridItemsLayout
                    Orientation="Vertical"
                    Span="2"
                    HorizontalItemSpacing="12"
                    VerticalItemSpacing="12" />
            </CollectionView.ItemsLayout>

            <CollectionView.EmptyView>
                <VerticalStackLayout
                    Padding="{StaticResource PagePadding}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Spacing="{StaticResource ItemSpacing}">
                    <Label
                        Text="{Binding EmptyStateTitle}"
                        FontSize="{StaticResource FontSizeTitle}"
                        HorizontalOptions="Center" />
                    <Label
                        Text="{Binding EmptyStateSubtitle}"
                        Style="{StaticResource CaptionLabel}"
                        HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="data:Card">
                    <Border
                        Margin="4"
                        HeightRequest="160"
                        BackgroundColor="{Binding ., Converter={StaticResource CardToTileColor}}"
                        StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Padding="16" VerticalOptions="End" Spacing="2">
                            <Label
                                Text="{Binding DisplayName}"
                                TextColor="White"
                                FontSize="18"
                                FontAttributes="Bold"
                                LineBreakMode="TailTruncation"
                                MaxLines="2" />
                            <Label
                                Text="{Binding IssuerName}"
                                TextColor="White"
                                Opacity="0.85"
                                FontSize="12"
                                LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentPage>
