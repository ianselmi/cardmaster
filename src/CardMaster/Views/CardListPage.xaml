<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CardMaster.Views.CardListPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:data="clr-namespace:CardMaster.Data"
    xmlns:views="clr-namespace:CardMaster.Views"
    xmlns:vm="clr-namespace:CardMaster.ViewModels"
    x:Name="Page"
    Title="Le mie carte">

    <ContentPage.Resources>
        <views:CardToTileColorConverter x:Key="CardToTileColor" />
        <views:UpdateAvailableToIconConverter x:Key="UpdateAvailableToIcon" />
    </ContentPage.Resources>

    <ContentPage.ToolbarItems>
        <ToolbarItem
            Text="Impostazioni"
            IconImageSource="{Binding IsUpdateAvailable, Converter={StaticResource UpdateAvailableToIcon}}"
            Clicked="OnSettingsClicked" />
    </ContentPage.ToolbarItems>

    <!--
        Testata in VerticalStackLayout, non in righe di Grid: uno StackLayout dispone solo i
        figli visibili, mentre una riga di Grid alta 0 continua a produrre RowSpacing verso le
        adiacenti. Con gli elementi condizionali (banner, riga filtro, recenti) è la differenza
        tra "non occupa spazio" e "occupa solo la spaziatura".
    -->
    <Grid RowDefinitions="Auto,*">

        <VerticalStackLayout Grid.Row="0" Spacing="{StaticResource ItemSpacing}">

        <Border
            Margin="20,8,20,0"
            Padding="12"
            IsVisible="{Binding IsUpdateAvailable}"
            BackgroundColor="{StaticResource Secondary}"
            StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnUpdateBannerTapped" />
            </Border.GestureRecognizers>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Label
                    Grid.Column="0"
                    Text="{Binding UpdateAvailableVersion, StringFormat='È disponibile la versione {0}. Tocca per aggiornare.'}"
                    TextColor="{StaticResource PrimaryDarkText}"
                    FontSize="{StaticResource FontSizeBody}"
                    VerticalOptions="Center" />
                <Label
                    Grid.Column="1"
                    Text="✕"
                    TextColor="{StaticResource PrimaryDarkText}"
                    VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnUpdateBannerDismissTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </Grid>
        </Border>

        <SearchBar
            Margin="20,0"
            Placeholder="Cerca per nome o emittente"
            Text="{Binding SearchText}" />

        <!--
            Riga filtro: conteggio (solo sotto filtro) e chip delle label (solo se ne esistono),
            con visibilità indipendenti. Se non c'è né l'uno né gli altri l'intera riga sparisce.
        -->
        <Grid
            Margin="20,0"
            ColumnDefinitions="Auto,*"
            ColumnSpacing="{StaticResource ItemSpacing}"
            HeightRequest="{StaticResource FilterChipRowHeight}"
            IsVisible="{Binding HasFilterRow}">

            <Label
                Grid.Column="0"
                Text="{Binding CountText}"
                IsVisible="{Binding HasActiveFilter}"
                Style="{StaticResource CaptionLabel}"
                VerticalOptions="Center" />

            <!-- Filtro per label: selezione multipla in OR, nascosto finché non esiste nessuna label -->
            <CollectionView
                Grid.Column="1"
                IsVisible="{Binding HasLabelFilters}"
                ItemsSource="{Binding LabelFilters}"
                SelectionMode="None">

            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:LabelFilterItem">
                    <!-- Niente margine verticale: l'altezza la detta la riga, e un margine qui
                         taglierebbe il chip invece di distanziarlo. -->
                    <Border
                        Padding="12,4"
                        BackgroundColor="Transparent"
                        Stroke="{StaticResource Gray300}"
                        StrokeThickness="1"
                        VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding BindingContext.ToggleLabelFilterCommand, Source={x:Reference Page}, x:DataType='vm:CardListViewModel'}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                <Setter Property="Stroke" Value="{StaticResource Primary}" />
                            </DataTrigger>
                        </Border.Triggers>

                        <Label
                            Text="{Binding Name}"
                            FontSize="{StaticResource FontSizeBody}"
                            VerticalOptions="Center">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="TextColor" Value="White" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <!--
            Barra dei recenti senza didascalia: i riquadri più piccoli la distinguono già dalla
            griglia, e una riga di testo per dirlo costerebbe quanto la barra stessa.
        -->
        <CollectionView
            Margin="20,0"
            HeightRequest="{StaticResource RecentCardsRowHeight}"
            IsVisible="{Binding HasRecentCards}"
            ItemsSource="{Binding RecentCards}"
            SelectionMode="Single"
            SelectionChanged="OnCardSelected">

            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="12" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="data:Card">
                    <Border
                        WidthRequest="{StaticResource RecentCardWidth}"
                        HeightRequest="{StaticResource RecentCardsRowHeight}"
                        BackgroundColor="{Binding ., Converter={StaticResource CardToTileColor}}"
                        StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Padding="8" VerticalOptions="End" Spacing="0">
                            <Label
                                Text="{Binding DisplayName}"
                                TextColor="White"
                                FontSize="12"
                                FontAttributes="Bold"
                                LineBreakMode="TailTruncation"
                                MaxLines="2" />
                            <Label
                                Text="{Binding IssuerName}"
                                TextColor="White"
                                Opacity="0.85"
                                FontSize="10"
                                LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

        </VerticalStackLayout>

        <CollectionView
            Grid.Row="1"
            Margin="0,8,0,0"
            ItemsSource="{Binding FilteredCards}"
            SelectionMode="Single"
            SelectionChanged="OnCardSelected">

            <CollectionView.ItemsLayout>
                <GridItemsLayout
                    Orientation="Vertical"
                    Span="2"
                    HorizontalItemSpacing="12"
                    VerticalItemSpacing="12" />
            </CollectionView.ItemsLayout>

            <!-- Spazio scrollabile sotto l'ultima riga, così il bottone tondo non la copre.
                 BackgroundColor esplicito oltre a Color: lo stile implicito di BoxView in
                 Styles.xaml dipinge il *BackgroundColor* (Gray950), quindi il solo
                 Color="Transparent" lascerebbe una fascia nera larga tutta la pagina. -->
            <CollectionView.Footer>
                <BoxView
                    HeightRequest="{StaticResource CardGridBottomInset}"
                    Color="Transparent"
                    BackgroundColor="Transparent" />
            </CollectionView.Footer>

            <CollectionView.EmptyView>
                <VerticalStackLayout
                    Padding="{StaticResource PagePadding}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Spacing="{StaticResource ItemSpacing}">
                    <Label
                        Text="{Binding EmptyStateTitle}"
                        FontSize="{StaticResource FontSizeTitle}"
                        HorizontalOptions="Center" />
                    <Label
                        Text="{Binding EmptyStateSubtitle}"
                        Style="{StaticResource CaptionLabel}"
                        HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="data:Card">
                    <Border
                        Margin="4"
                        HeightRequest="160"
                        BackgroundColor="{Binding ., Converter={StaticResource CardToTileColor}}"
                        StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Padding="16" VerticalOptions="End" Spacing="2">
                            <Label
                                Text="{Binding DisplayName}"
                                TextColor="White"
                                FontSize="18"
                                FontAttributes="Bold"
                                LineBreakMode="TailTruncation"
                                MaxLines="2" />
                            <Label
                                Text="{Binding IssuerName}"
                                TextColor="White"
                                Opacity="0.85"
                                FontSize="12"
                                LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

        <!--
            Aggiunta carta come bottone tondo: sovrapposto alla griglia nella *stessa* cella
            (secondo figlio di Grid.Row=1), non in una riga propria, altrimenti sottrarrebbe
            altezza alle carte — proprio ciò che maui-card-list-compact-header ha recuperato.
            Fuori dall'area scrollabile, quindi resta fermo mentre la lista scorre.
        -->
        <Button
            Grid.Row="1"
            Text="+"
            SemanticProperties.Description="Aggiungi carta"
            WidthRequest="{StaticResource AddFabSize}"
            HeightRequest="{StaticResource AddFabSize}"
            CornerRadius="{StaticResource AddFabCornerRadius}"
            FontSize="{StaticResource AddFabGlyphFontSize}"
            Padding="0"
            Margin="{StaticResource AddFabMargin}"
            HorizontalOptions="Center"
            VerticalOptions="End"
            Clicked="OnAddClicked">
            <Button.Shadow>
                <Shadow Brush="Black" Opacity="0.3" Radius="8" Offset="0,2" />
            </Button.Shadow>
        </Button>

    </Grid>

</ContentPage>
