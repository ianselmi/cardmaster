<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CardMaster.Views.ShowCardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="{Binding DisplayName}">

    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource PagePadding}" Spacing="{StaticResource SectionSpacing}">

            <Label
                Text="{Binding IssuerName}"
                Style="{StaticResource CaptionLabel}"
                HorizontalOptions="Center" />

            <!-- Avviso filtro luce blu (best-effort), nascosto per default -->
            <Border
                x:Name="ReadingFilterBanner"
                IsVisible="False"
                Padding="12,8"
                BackgroundColor="#FFF3CD">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <Label
                    Text="Filtro luce blu attivo: disattivalo per una lettura migliore alla cassa."
                    FontSize="12"
                    TextColor="#664D03" />
            </Border>

            <!-- Area barcode: SEMPRE su sfondo bianco, anche in dark mode -->
            <Border
                Padding="16"
                BackgroundColor="White"
                HorizontalOptions="Fill">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="12">
                    <!-- Nome della carta in cima al riquadro che si porge al cassiere: si legge
                         nell'ordine naturale (quale carta, poi il suo codice). Fascia a tutta
                         larghezza col colore identitario della carta — lo stesso del riquadro
                         nella griglia — così il colore riguarda la riga del nome e non l'area
                         del barcode, che resta bianca. Testo bianco senza AppThemeBinding:
                         la palette è tarata per il bianco e la fascia non cambia col tema. -->
                    <Border
                        Padding="12,8"
                        BackgroundColor="{Binding TileColor}"
                        StrokeThickness="0"
                        HorizontalOptions="Fill">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Label
                            Text="{Binding DisplayName}"
                            FontSize="{StaticResource FontSizeTitle}"
                            FontAttributes="Bold"
                            TextColor="White"
                            MaxLines="2"
                            HorizontalTextAlignment="Center" />
                    </Border>

                    <Image
                        Source="{Binding BarcodeImage}"
                        IsVisible="{Binding BarcodeAvailable}"
                        Aspect="AspectFit"
                        HeightRequest="240"
                        HorizontalOptions="Center" />

                    <Label
                        Text="Impossibile generare il codice: mostra il numero al cassiere."
                        IsVisible="{Binding BarcodeUnavailable}"
                        FontSize="13"
                        TextColor="#B00020"
                        HorizontalTextAlignment="Center" />

                    <!-- Codice in chiaro: SEMPRE visibile -->
                    <Label
                        Text="{Binding BarcodeValue}"
                        FontSize="{StaticResource FontSizeTitle}"
                        FontAttributes="Bold"
                        TextColor="Black"
                        HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <!--
                Label della carta, in sola lettura (si assegnano dalla modifica): sotto l'area
                barcode e non sopra, così una carta con molte label non spinge in basso il
                motivo per cui questa pagina esiste. FlexLayout con Wrap: i chip vanno a capo
                invece di uscire dallo schermo. Nascosto per intero se la carta non ha label —
                dentro un VerticalStackLayout un figlio invisibile non occupa né spazio né
                spaziatura, quindi non serve nascondere altro.
            -->
            <FlexLayout
                IsVisible="{Binding HasLabels}"
                BindableLayout.ItemsSource="{Binding Labels}"
                Wrap="Wrap"
                Direction="Row"
                AlignItems="Start"
                JustifyContent="Start">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="{x:Type x:String}">
                        <!-- Shrink="0": senza, FlexLayout comprime i chip sotto la loro larghezza
                             naturale pur di farceli stare in riga, e il testo si tronca ("spesa"
                             diventa "spes"). A 0 il chip tiene la sua misura e va a capo.
                             Padding orizzontale 16 e non 12 come nell'editor: lì il testo è
                             seguito dalla ✕, qui arriva al bordo del chip e l'arrotondamento
                             della misura del testo su Android ne mangia l'ultima lettera. -->
                        <Border
                            Margin="0,0,8,8"
                            Padding="16,6"
                            FlexLayout.Shrink="0"
                            BackgroundColor="{StaticResource Secondary}"
                            StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16" />
                            </Border.StrokeShape>
                            <Label
                                Text="{Binding .}"
                                TextColor="{StaticResource PrimaryDarkText}"
                                FontSize="{StaticResource FontSizeBody}"
                                VerticalOptions="Center" />
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>

            <!-- Azioni sulla carta: sotto l'immagine generata -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="{StaticResource ItemSpacing}">
                <Button
                    Grid.Column="0"
                    Text="Condividi"
                    Clicked="OnShareClicked" />
                <Button
                    Grid.Column="1"
                    Text="Modifica"
                    Clicked="OnEditClicked" />
                <Button
                    Grid.Column="2"
                    Text="Elimina"
                    BackgroundColor="#B00020"
                    TextColor="White"
                    Clicked="OnDeleteClicked" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
