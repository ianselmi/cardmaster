<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CardMaster.Views.ShowCardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="{Binding DisplayName}">

    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource PagePadding}" Spacing="{StaticResource SectionSpacing}">

            <Label
                Text="{Binding IssuerName}"
                Style="{StaticResource CaptionLabel}"
                HorizontalOptions="Center" />

            <!-- Avviso filtro luce blu (best-effort), nascosto per default -->
            <Border
                x:Name="ReadingFilterBanner"
                IsVisible="False"
                Padding="12,8"
                BackgroundColor="#FFF3CD">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <Label
                    Text="Filtro luce blu attivo: disattivalo per una lettura migliore alla cassa."
                    FontSize="12"
                    TextColor="#664D03" />
            </Border>

            <!-- Area barcode: SEMPRE su sfondo bianco, anche in dark mode -->
            <Border
                Padding="16"
                BackgroundColor="White"
                HorizontalOptions="Fill">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="12">
                    <Image
                        Source="{Binding BarcodeImage}"
                        IsVisible="{Binding BarcodeAvailable}"
                        Aspect="AspectFit"
                        HeightRequest="240"
                        HorizontalOptions="Center" />

                    <Label
                        Text="Impossibile generare il codice: mostra il numero al cassiere."
                        IsVisible="{Binding BarcodeUnavailable}"
                        FontSize="13"
                        TextColor="#B00020"
                        HorizontalTextAlignment="Center" />

                    <!-- Codice in chiaro: SEMPRE visibile -->
                    <Label
                        Text="{Binding BarcodeValue}"
                        FontSize="{StaticResource FontSizeTitle}"
                        FontAttributes="Bold"
                        TextColor="Black"
                        HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- Azioni sulla carta: sotto l'immagine generata -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="{StaticResource ItemSpacing}">
                <Button
                    Grid.Column="0"
                    Text="Condividi"
                    Clicked="OnShareClicked" />
                <Button
                    Grid.Column="1"
                    Text="Modifica"
                    Clicked="OnEditClicked" />
                <Button
                    Grid.Column="2"
                    Text="Elimina"
                    BackgroundColor="#B00020"
                    TextColor="White"
                    Clicked="OnDeleteClicked" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
