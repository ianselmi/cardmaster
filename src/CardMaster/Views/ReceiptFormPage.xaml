<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CardMaster.Views.ReceiptFormPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:CardMaster.ViewModels"
    x:Name="PageRoot"
    Title="Controlla i dati">

    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource PagePadding}" Spacing="{StaticResource SectionSpacing}">

            <!--
                La quadratura sta in cima, prima dell'elenco delle righe: se il totale torna
                l'utente conferma e basta, e scende nel dettaglio solo quando qualcosa non torna.
            -->
            <Border Padding="12" StrokeThickness="1">
                <Label Text="{Binding BalanceMessage}" Style="{StaticResource CaptionLabel}" />
            </Border>

            <Label
                IsVisible="{Binding HasNotRecognized}"
                Text="{Binding NotRecognizedMessage}"
                Style="{StaticResource CaptionLabel}" />

            <!--
                Rilettura con il modello. Compare SOLO quando la quadratura è fallita e la
                funzione è accesa con una chiave: su uno scontrino che torna non se ne parla
                nemmeno, così il costo resta proporzionale al problema e non al numero di
                scontrini. Sparisce da sola appena una correzione a mano fa tornare i conti.
            -->
            <Button
                IsVisible="{Binding CanRescanWithAi}"
                Text="Rileggi con l'AI"
                Clicked="OnRescanWithAiClicked" />

            <ActivityIndicator
                IsVisible="{Binding IsAiRescanRunning}"
                IsRunning="{Binding IsAiRescanRunning}"
                HorizontalOptions="Start" />

            <Label
                IsVisible="{Binding HasAiRescanMessage}"
                Text="{Binding AiRescanMessage}"
                Style="{StaticResource CaptionLabel}" />

            <VerticalStackLayout Spacing="4">
                <Label Text="Esercente" Style="{StaticResource CaptionLabel}" />
                <Entry Text="{Binding MerchantName}" Placeholder="Nome del negozio" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Label Text="Partita IVA" Style="{StaticResource CaptionLabel}" />
                <Entry Text="{Binding MerchantVatId}" Keyboard="Numeric" Placeholder="11 cifre" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Label Text="Data dell'acquisto" Style="{StaticResource CaptionLabel}" />
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <CheckBox Grid.Column="0" IsChecked="{Binding HasDate}" />
                    <DatePicker Grid.Column="1" Date="{Binding PurchaseDate}" IsEnabled="{Binding HasDate}" />
                </Grid>
                <Label
                    Text="Senza data lo scontrino resta salvato ma non entra nei totali di spesa."
                    Style="{StaticResource CaptionLabel}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Label Text="Totale" Style="{StaticResource CaptionLabel}" />
                <Entry Text="{Binding TotalText}" Keyboard="Numeric" Placeholder="12,34" />
            </VerticalStackLayout>

            <BoxView HeightRequest="1" Color="{StaticResource Gray300}" Margin="0,8" />

            <Label Text="Righe" Style="{StaticResource SubHeadline}" />

            <CollectionView ItemsSource="{Binding Items}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ReceiptItemViewModel">
                        <VerticalStackLayout Spacing="4" Margin="0,0,0,12">
                            <Entry Text="{Binding Description}" Placeholder="Descrizione" />
                            <Grid ColumnDefinitions="*,*,*,Auto" ColumnSpacing="6">
                                <Entry
                                    Grid.Column="0"
                                    Text="{Binding QuantityText}"
                                    Keyboard="Numeric"
                                    Placeholder="Q.tà" />
                                <Entry
                                    Grid.Column="1"
                                    Text="{Binding VatText}"
                                    Keyboard="Numeric"
                                    Placeholder="IVA %" />
                                <Entry
                                    Grid.Column="2"
                                    Text="{Binding AmountText}"
                                    Keyboard="Numeric"
                                    Placeholder="Importo" />
                                <Button
                                    Grid.Column="3"
                                    Text="✕"
                                    WidthRequest="44"
                                    Clicked="OnRemoveItemClicked" />
                            </Grid>
                            <Picker
                                ItemsSource="{Binding BindingContext.CategoryNames, Source={x:Reference PageRoot}}"
                                SelectedItem="{Binding Category}"
                                Title="Categoria" />
                            <Label
                                IsVisible="{Binding HasWarning}"
                                Text="Quantità e prezzo unitario non tornano con l'importo stampato."
                                Style="{StaticResource CaptionLabel}" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button Text="Aggiungi riga" Clicked="OnAddItemClicked" />

            <Button Text="Salva" Clicked="OnSaveClicked" Margin="0,12,0,0" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
