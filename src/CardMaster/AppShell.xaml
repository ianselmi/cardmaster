<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="CardMaster.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:CardMaster.Views"
    Shell.BackgroundColor="{DynamicResource Primary}"
    Shell.ForegroundColor="{DynamicResource White}"
    Shell.TitleColor="{DynamicResource White}"
    Title="CardMaster">

    <!-- TabBar e non due ShellContent nudi: con quelli Shell costruisce un menu a panino
         (flyout), che nasconde la sezione dietro un gesto. Le due funzioni sono pari-grado e
         vanno dove un utente Android le cerca, cioè nella barra in basso. -->
    <TabBar>
        <ShellContent
            Title="Le mie carte"
            ContentTemplate="{DataTemplate views:CardListPage}"
            Route="CardListPage" />

        <ShellContent
            Title="Scontrini"
            ContentTemplate="{DataTemplate views:ReceiptsPage}"
            Route="ReceiptsPage" />
    </TabBar>

</Shell>
