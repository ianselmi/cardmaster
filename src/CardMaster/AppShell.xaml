<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="CardMaster.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:CardMaster.Views"
    Shell.BackgroundColor="{DynamicResource Primary}"
    Shell.ForegroundColor="{DynamicResource White}"
    Shell.TitleColor="{DynamicResource White}"
    Title="CardMaster">

    <ShellContent
        Title="Le mie carte"
        ContentTemplate="{DataTemplate views:CardListPage}"
        Route="CardListPage" />

</Shell>
